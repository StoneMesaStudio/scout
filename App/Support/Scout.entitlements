<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately unsandboxed. A sandboxed app can only see files handed to it one at a
	     time through an open panel, which would make a search tool pointless — and Full Disk
	     Access, which the Mail and Messages lanes need, cannot be granted to a sandboxed app
	     at all. This is why Scout ships as a signed direct download rather than on the App
	     Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Required for Contacts, and the reason the Contacts prompt never appeared: with the
	     hardened runtime on, macOS blocks the protected resources an app has not declared, and
	     reports the block as "restricted" rather than asking the user. From the outside that is
	     indistinguishable from the user having said no. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
